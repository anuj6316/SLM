# ==============================================================================
# DATABRICKS MLFLOW CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your credentials
# DO NOT commit .env to git!

# Databricks workspace URL (without trailing slash)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# Databricks Personal Access Token
# Generate at: User Settings -> Developer -> Access Tokens
DATABRICKS_TOKEN=dapi1234567890abcdef...

# MLflow tracking URI (use 'databricks' for Databricks MLflow)
MLFLOW_TRACKING_URI=databricks

# MLflow model registry URI (use 'databricks-uc' for Unity Catalog)
MLFLOW_REGISTRY_URI=databricks-uc

# MLflow Experiment ID or Name
# Create experiment in Databricks: AI/ML -> Experiments -> GenAI apps & agents
MLFLOW_EXPERIMENT_NAME=/Shared/text2sql-inference

# Optional: Experiment ID (alternative to name)
# MLFLOW_EXPERIMENT_ID=123456789
